# Copy to .env and change these before any real deployment.
# docker-compose.yml and src/dicom_connector/config.py both read these.
#
# dicom_app runs with network_mode: host (see docker-compose.yml), so it is
# NOT on the compose bridge network and cannot resolve other services by
# name ("db", "orthanc") - the *_HOST/*_URL values below that dicom_app
# uses must stay "localhost", reaching those services via their published
# ports, exactly like a process running directly on your machine would.

# --- Application DICOM/PACS settings ---
DICOM_PACS_HOST=localhost
DICOM_PACS_PORT=4242
DICOM_PACS_AE_TITLE=ORTHANC
DICOM_CALLING_AE_TITLE=MYAETITLE

# --- Application database ---
DICOM_DB_NAME=dicom_db
DICOM_DB_USER=dicom_user
DICOM_DB_PASSWORD=change-me
DICOM_DB_HOST=localhost
DICOM_DB_PORT=5432

# --- Orthanc REST API ---
ORTHANC_HTTP_URL=http://localhost:8042
ORTHANC_HTTP_USERNAME=orthanc
ORTHANC_HTTP_PASSWORD=change-me

# --- Orthanc's own PostgreSQL index/storage database (separate from the app's) ---
ORTHANC_DB_NAME=orthanc_db
ORTHANC_DB_USER=orthanc_user
ORTHANC_DB_PASSWORD=change-me

# X11 display for the Tk GUI (Linux hosts)
DISPLAY=:0
